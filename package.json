{
  "name": "dsh-memory-brain-plugin",
  "version": "1.0.0",
  "description": "记忆星脑: meow-memory 记忆库的 3D 神经贴图面板，左侧栏入口，桌面内嵌",
  "keywords": [
    "dsh",
    "memory",
    "3d",
    "visualization",
    "dsh-plugin"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale": "./locale/*.json",
    "./icon.svg": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "自由党",
    "本地",
    "网络",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "patch": {
      "path": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediate": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
